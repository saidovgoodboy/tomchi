APP_ENV=dev
DATABASE_URL=sqlite:///./backend/database/tomchi.db
DEVICE_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_SECONDS=28800
# Admin panel ochiladigan manzillar, vergul bilan. Public HTTPS bo'lsa: https://your-domain.example
# Tailscale ishlatsangiz tailnet IP'sini ham qo'shing: http://100.x.y.z:5173
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=
PORT=8000
ANPR_ENABLED=true
ANPR_TESSERACT_CMD=tesseract
ANPR_MIN_CONFIDENCE=0.45
ANPR_TIMEOUT_SECONDS=5
