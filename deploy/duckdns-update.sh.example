#!/bin/sh
set -eu

case "${DUCKDNS_DOMAIN:-}" in
	""|*[!A-Za-z0-9-]*)
		printf '%s\n' "DUCKDNS_DOMAIN must be one DuckDNS subdomain label." >&2
		exit 1
		;;
esac

case "${DUCKDNS_TOKEN:-}" in
	""|*[!A-Fa-f0-9-]*)
		printf '%s\n' "DUCKDNS_TOKEN is missing or malformed." >&2
		exit 1
		;;
esac

response=$(
	printf 'url = "https://www.duckdns.org/update?domains=%s&token=%s&ip="\n' \
		"$DUCKDNS_DOMAIN" "$DUCKDNS_TOKEN" |
		curl --config - --fail --silent --show-error
)

if [ "$response" != "OK" ]; then
	printf 'DuckDNS update failed (response: %s).\n' "$response" >&2
	exit 1
fi
